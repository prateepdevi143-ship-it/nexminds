rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{studentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == studentId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain');
    }
    match /company_logos/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == companyId;
    }
  }
}
