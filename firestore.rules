rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Health check / connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // USERS collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // STUDENTS collection
    match /students/{studentId} {
      allow read, write: if true;

      match /evidence/{evidenceId} {
        allow read, write: if true;
      }

      match /assessmentAttempts/{attemptId} {
        allow read, write: if true;
      }
    }

    // COMPANIES collection
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // JOBS collection (Job & Internship Postings)
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // APPLICATIONS collection (Real-Time Candidate Pipeline)
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // EVIDENCE collection (Skill Proofs & Verified Artifacts)
    match /evidence/{evidenceId} {
      allow read, write: if true;
    }

    // NOTIFICATIONS collection (Real-Time In-App Alerts)
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // RECRUITER FEEDBACKS collection (Evaluation & Constructive Notes)
    match /recruiterFeedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // REFERENCE CATALOGS: Skills, Careers, Courses, Assessments, Questions
    match /skills/{skillId} {
      allow read, write: if true;
    }

    match /careers/{careerId} {
      allow read, write: if true;
    }

    match /courses/{courseId} {
      allow read, write: if true;
    }

    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    match /questions/{questionId} {
      allow read, write: if true;
    }
  }
}
